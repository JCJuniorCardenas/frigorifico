# Producción con docker-compose.prod.yml. Copiar a .env.prod (no se versiona) y completar.
# Generar secretos con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Dominio público de la web (el DNS tiene que apuntar a este servidor)
DOMAIN=faena.ejemplo.com.ar

# Base de datos (solo accesible dentro de Docker)
POSTGRES_USER=frigorifico
POSTGRES_PASSWORD=cambiar-por-una-clave-larga
POSTGRES_DB=frigorifico

# CUIT del frigorífico emisor
ISSUER_CUIT=27252783119

# Secretos de sesión: largos, aleatorios y distintos entre sí
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Primer ADMIN (se crea con: docker compose -f docker-compose.prod.yml exec api pnpm db:seed)
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
