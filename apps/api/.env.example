# Puerto de la API
PORT=4000
# Origen permitido para CORS (frontend)
WEB_ORIGIN=http://localhost:3000
# Conexión a Postgres de Docker (puerto 5440 para no chocar con otros Postgres locales)
DATABASE_URL="postgresql://frigorifico:frigorifico@localhost:5440/frigorifico?schema=public"
# CUIT del frigorífico emisor (11 dígitos, sin guiones)
ISSUER_CUIT=27252783119
# Secretos JWT (generar valores largos y aleatorios en producción)
JWT_ACCESS_SECRET=cambiar-en-produccion
JWT_REFRESH_SECRET=cambiar-en-produccion
# Storage de PDFs: "local" en desarrollo
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Duración de los tokens
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Primer ADMIN (lo crea `pnpm --filter api db:seed` si no hay ninguno)
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@frigorifico.local
SEED_ADMIN_PASSWORD=cambiar-esta-clave
