// Esquema de la base de datos. Los modelos se agregan por fase (ver CLAUDE.md §4 y §13).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum InvoiceStatus {
  PENDING
  PAID
}

model User {
  id                String             @id @default(uuid())
  name              String
  email             String             @unique
  passwordHash      String
  role              Role               @default(USER)
  active            Boolean            @default(true)
  // Se incrementa al cerrar sesión, desactivar o resetear la clave: invalida los refresh tokens emitidos.
  tokenVersion      Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  invoices          Invoice[]          @relation("UploadedBy")
  paidInvoices      Invoice[]          @relation("PaidBy")
  invoiceStatusLogs InvoiceStatusLog[]
  purchases         Purchase[]
  stockMovements    StockMovement[]
}

model Invoice {
  id             String             @id @default(uuid())
  salesPoint     String // "00004"
  voucherNumber  String // "00000115"
  issueDate      DateTime           @db.Date
  paymentDueDate DateTime           @db.Date
  clientName     String // Razón social del receptor
  clientCuit     String // 11 dígitos, sin guiones
  herdNumber     String // número de tropa, ej "15005"
  slaughterKg    Decimal            @db.Decimal(12, 2)
  totalAmount    Decimal            @db.Decimal(14, 2)
  netTaxedAmount Decimal            @db.Decimal(14, 2)
  vat21Amount    Decimal            @db.Decimal(14, 2)
  exemptAmount   Decimal            @db.Decimal(14, 2)
  cae            String
  caeDueDate     DateTime           @db.Date
  status         InvoiceStatus      @default(PENDING)
  paidAt         DateTime?          @db.Date // fecha en que se cobró (editable)
  paidById       String? // usuario que la marcó como pagada
  paidBy         User?              @relation("PaidBy", fields: [paidById], references: [id])
  pdfKey         String // clave en el storage
  pdfHash        String             @unique // sha256 del archivo
  needsReview    Boolean            @default(false)
  uploadedById   String
  uploadedBy     User               @relation("UploadedBy", fields: [uploadedById], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  statusLogs     InvoiceStatusLog[]

  @@unique([salesPoint, voucherNumber])
  @@index([herdNumber])
  @@index([clientName])
  @@index([paymentDueDate])
  @@index([status])
}

// Auditoría de cambios de estado (pagada / pendiente).
model InvoiceStatusLog {
  id          String        @id @default(uuid())
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  fromStatus  InvoiceStatus
  toStatus    InvoiceStatus
  changedById String
  changedBy   User          @relation(fields: [changedById], references: [id])
  changedAt   DateTime      @default(now())

  @@index([invoiceId])
}

// ── Módulo 2: stock y ventas (ver MODULO-STOCK.md) ──────────────────────────────────────────

enum ProductUnit {
  KG
  UNIT
}

model Supplier {
  id        String     @id @default(uuid())
  name      String
  cuit      String?    @unique // 11 dígitos, sin guiones
  phone     String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases Purchase[]

  @@index([name])
}

model Product {
  id            String          @id @default(uuid())
  name          String          @unique
  category      String? // vacuno, cerdo, pollo, achuras, etc.
  unit          ProductUnit     @default(KG)
  salePrice     Decimal?        @db.Decimal(14, 2) // precio sugerido por kg (o por unidad)
  minStockKg    Decimal?        @db.Decimal(12, 3) // umbral opcional de alerta de stock bajo
  // Costo promedio ponderado por kg. Lo mantiene StockService al registrar ingresos; 4 decimales
  // para no acumular redondeos entre recálculos.
  avgCost       Decimal         @default(0) @db.Decimal(14, 4)
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  movements     StockMovement[]
  purchaseItems PurchaseItem[]
}

enum MovementType {
  PURCHASE // ingreso de mercadería (+)
  SALE // venta (-)
  WASTE // merma (-)
  ADJUSTMENT // ajuste por conteo (+/-)
  SALE_VOID // anulación de venta (+)
}

// Ingreso de mercadería. No se edita ni se borra: se corrige con un ajuste de stock.
model Purchase {
  id          String         @id @default(uuid())
  date        DateTime       @db.Date
  supplierId  String
  supplier    Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  herdNumber  String? // número de tropa, para trazabilidad
  notes       String?
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  items       PurchaseItem[]

  @@index([date])
  @@index([herdNumber])
  @@index([supplierId])
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  line       Int // orden de carga del ítem dentro del ingreso (1, 2, ...)
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  kg         Decimal  @db.Decimal(12, 3)
  costPerKg  Decimal  @db.Decimal(14, 2)
  totalCost  Decimal  @db.Decimal(14, 2)

  @@unique([purchaseId, line])
  @@index([productId])
}

// Libro de movimientos: el stock de un producto es la suma de sus kg. Nunca se editan ni borran.
model StockMovement {
  id          String       @id @default(uuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  type        MovementType
  kg          Decimal      @db.Decimal(12, 3) // con signo: + entra, - sale
  unitCost    Decimal?     @db.Decimal(14, 2)
  reason      String? // obligatorio en WASTE y ADJUSTMENT
  refType     String? // "Purchase" | "Sale"
  refId       String?
  date        DateTime     @db.Date
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  @@index([productId, date])
  @@index([refType, refId])
}
